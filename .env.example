# Copy to .env and fill in. Never commit .env.

# Postgres superuser (dev container only)
POSTGRES_PASSWORD=

# Database roles created by db/init/01-roles.sh
CBAM_OWNER_PASSWORD=
CBAM_APP_PASSWORD=

# Used by dbmate (migrations run as the owner role)
DATABASE_URL=postgres://cbam_owner:<CBAM_OWNER_PASSWORD>@localhost:5432/cbam?sslmode=disable

# Used by the API (runtime role, subject to row-level security)
APP_DATABASE_URL=postgres://cbam_app:<CBAM_APP_PASSWORD>@localhost:5432/cbam?sslmode=disable

# API
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# 32 random bytes, base64: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=120
INVITATION_TTL_HOURS=72

# Object storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=cbam-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mail (Mailpit in dev)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=CBAM reporting <no-reply@localhost>
