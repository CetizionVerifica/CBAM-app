# Copy to .env and fill in. Never commit .env.

# Host ports for the dev containers (change when another project already uses them)
# POSTGRES_PORT=5432
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Postgres superuser (dev container only)
POSTGRES_PASSWORD=

# Database roles created by db/init/01-roles.sh
CBAM_OWNER_PASSWORD=
CBAM_APP_PASSWORD=

# Used by dbmate (migrations run as the owner role)
DATABASE_URL=postgres://cbam_owner:<CBAM_OWNER_PASSWORD>@localhost:5432/cbam?sslmode=disable

# Used by the API (runtime role, subject to row-level security)
APP_DATABASE_URL=postgres://cbam_app:<CBAM_APP_PASSWORD>@localhost:5432/cbam?sslmode=disable

# API
NODE_ENV=development
# API port; the web dev server proxies /api to it
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# 32 random bytes, base64: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=120
INVITATION_TTL_HOURS=72

# File storage: Cloudinary (decision D13). From the Cloudinary console → API Keys:
# cloudinary://<api_key>:<api_secret>@<cloud_name>. Optional in development (uploads are
# then unavailable), required in production. Use a separate folder per environment.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=cbam-dev

# Mail (Mailpit in dev)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=CBAM reporting <no-reply@localhost>
